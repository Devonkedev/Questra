---
import Layout from '../layouts/Layout.astro';
import AskDoubtForm from '../components/AskDoubtForm';
---

<Layout title="Ask a Doubt">
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-[#A00021] mb-2">Ask a Doubt</h1>
        <p class="text-gray-600">Get help from teachers and verified answers</p>
      </div>
      <AskDoubtForm client:load />
    </div>
  </div>
</Layout>

