---
import Layout from '../layouts/Layout.astro';
import UploadForm from '../components/UploadForm';
import AuthGate from '../components/AuthGate';
---

<Layout title="Upload Resource">
  <AuthGate client:load>
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bold text-[#312E81] mb-2">Upload Resource</h1>
          <p class="text-gray-600">Share notes and study materials with students</p>
        </div>
        <UploadForm client:load />
      </div>
    </div>
  </AuthGate>
</Layout>

