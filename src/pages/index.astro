---
import Layout from '../layouts/Layout.astro';
import HomeRedirect from '../components/HomeRedirect';
---

<Layout title="Home">
  <HomeRedirect client:load />
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-[#DC143C] via-[#C41E3A] to-[#DC143C] text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <div class="flex justify-center items-center mb-6">
        <div class="h-20 w-20 md:h-24 md:w-24 bg-white rounded-xl p-2 flex items-center justify-center shadow-lg mr-4 border-2 border-white/30">
          <img 
            src="/logo.png" 
            alt="Shri Logo" 
            class="max-h-full max-w-full object-contain"
            loading="eager"
            width="80"
            height="80"
            onerror="console.error('Logo failed to load'); this.style.display='none';"
          />
        </div>
        <h1 class="text-5xl md:text-6xl font-bold">
          ShriSolve
        </h1>
      </div>
      <p class="text-2xl md:text-3xl mb-4 bg-gradient-to-r from-[#FFB347] to-[#FF8C00] bg-clip-text text-transparent font-semibold">
        Where curiosity meets clarity.
      </p>
      <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto text-gray-100">
        A safe, structured space for TSRS students to ask doubts and teachers to guide them.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/login"
          class="bg-gradient-to-r from-[#FF8C00] to-[#FFB347] text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-[#FF7F00] hover:to-[#FFA500] transition-all shadow-xl hover:shadow-2xl transform hover:scale-105"
        >
          Get Started
        </a>
        <a 
          href="/login"
          class="bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 hover:border-white/50 transition-all shadow-lg"
        >
          Login
        </a>
      </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">
        How It Works
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl p-8 text-center transition-all transform hover:-translate-y-1 border border-gray-100">
          <div class="w-16 h-16 bg-gradient-to-br from-[#DC143C] to-[#C41E3A] rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Ask Questions</h3>
          <p class="text-gray-600">
            Students can post questions anonymously or with their name, choose subjects, and attach files.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl p-8 text-center transition-all transform hover:-translate-y-1 border border-gray-100">
          <div class="w-16 h-16 bg-gradient-to-br from-[#FF8C00] to-[#FFB347] rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Get Verified Answers</h3>
          <p class="text-gray-600">
            Teachers provide detailed answers and verify responses to ensure accuracy.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl p-8 text-center transition-all transform hover:-translate-y-1 border border-gray-100">
          <div class="w-16 h-16 bg-gradient-to-br from-[#DC143C] to-[#C41E3A] rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Access Resources</h3>
          <p class="text-gray-600">
            Browse and download teacher-uploaded notes, study materials, and resources.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-gradient-to-r from-[#FFB347] via-[#FF8C00] to-[#FFB347] py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="text-3xl font-bold bg-gradient-to-r from-[#DC143C] to-[#C41E3A] bg-clip-text text-transparent mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-lg text-gray-800 mb-8 font-medium">
        Join the TSRS Moulsari community and start learning together.
      </p>
      <a 
        href="/login"
        class="inline-block bg-gradient-to-r from-[#DC143C] to-[#C41E3A] text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-[#C41E3A] hover:to-[#DC143C] transition-all shadow-xl hover:shadow-2xl transform hover:scale-105"
      >
        Get Started
      </a>
    </div>
  </section>
</Layout>
