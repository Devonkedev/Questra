---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-[#A00021] to-[#A00021]/90 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        ShriSolve
      </h1>
      <p class="text-2xl md:text-3xl mb-4 text-[#F7C548]">
        Where curiosity meets clarity.
      </p>
      <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto text-gray-200">
        A safe, structured space for TSRS students to ask doubts and teachers to guide them.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/ask"
          class="bg-[#F7C548] text-[#A00021] px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#F7C548]/90 transition-colors shadow-lg"
        >
          Ask a Doubt
        </a>
        <a 
          href="/login"
          class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-colors"
        >
          Teacher Login
        </a>
        <a 
          href="/notes"
          class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-colors"
        >
          Browse Notes
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">
        How It Works
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl shadow-md p-8 text-center">
          <div class="w-16 h-16 bg-[#A00021] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Ask Questions</h3>
          <p class="text-gray-600">
            Students can post questions anonymously or with their name, choose subjects, and attach files.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-md p-8 text-center">
          <div class="w-16 h-16 bg-[#F7C548] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#A00021]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Get Verified Answers</h3>
          <p class="text-gray-600">
            Teachers provide detailed answers and verify responses to ensure accuracy.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-md p-8 text-center">
          <div class="w-16 h-16 bg-[#A00021] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Access Resources</h3>
          <p class="text-gray-600">
            Browse and download teacher-uploaded notes, study materials, and resources.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-[#F7C548] py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-[#A00021] mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-lg text-gray-800 mb-8">
        Join the TSRS Moulsari community and start learning together.
      </p>
      <a 
        href="/ask"
        class="inline-block bg-[#A00021] text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#A00021]/90 transition-colors shadow-lg"
      >
        Ask Your First Question
      </a>
    </div>
  </section>
</Layout>
