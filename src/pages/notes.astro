---
import Layout from '../layouts/Layout.astro';
import NotesList from '../components/NotesList';
import AuthGate from '../components/AuthGate';
import UploadButton from '../components/UploadButton';
---

<Layout title="Notes">
  <AuthGate client:load>
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-[#312E81] mb-2">Study Resources</h1>
        <p class="text-gray-600">Browse and download teacher-uploaded notes and materials</p>
        <UploadButton client:load />
      </div>
      
      <NotesList client:load initialNotes={[]} />
    </div>
  </AuthGate>
</Layout>

