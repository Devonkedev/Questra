---
import Layout from '../layouts/Layout.astro';
import DoubtCard from '../components/DoubtCard.astro';
import DoubtsList from '../components/DoubtsList';
import AuthGate from '../components/AuthGate';
---

<Layout title="Doubts">
  <AuthGate client:load>
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-[#312E81] mb-2">All Doubts</h1>
        <p class="text-gray-600">Browse and answer questions from students</p>
        <a 
          href="/ask" 
          class="inline-block mt-4 bg-gradient-to-r from-[#5EEAD4] to-[#2DD4BF] text-[#1E1B4B] px-6 py-3 rounded-xl font-bold hover:from-[#2DD4BF] hover:to-[#14B8A6] transition-all shadow-lg"
        >
          + Ask a Doubt
        </a>
      </div>
      
      <DoubtsList client:load initialQuestions={[]} />
    </div>
  </AuthGate>
</Layout>

