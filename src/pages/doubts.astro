---
import Layout from '../layouts/Layout.astro';
import DoubtCard from '../components/DoubtCard.astro';
import { getQuestions } from '../lib/firestore';
import DoubtsList from '../components/DoubtsList';
import AuthGate from '../components/AuthGate';

// Get initial questions (limited for performance)
const questions = await getQuestions({}, 50);
---

<Layout title="Doubts">
  <AuthGate client:load>
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-[#A00021] mb-2">All Doubts</h1>
        <p class="text-gray-600">Browse and answer questions from students</p>
        <a 
          href="/ask" 
          class="inline-block mt-4 bg-gradient-to-r from-[#FFD700] to-[#FFA500] text-white px-6 py-3 rounded-xl font-bold hover:from-[#FFB300] hover:to-[#FF9500] transition-all shadow-lg"
        >
          + Ask a Doubt
        </a>
      </div>
      
      <DoubtsList client:load initialQuestions={questions} />
    </div>
  </AuthGate>
</Layout>

