---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DoubtDetail from '../../components/DoubtDetail';
import AuthGate from '../../components/AuthGate';

const { id } = Astro.params;
// Don't fetch server-side - Firebase doesn't work on server
const question = { id };
const replies = [];
---

<Layout title="Doubt Details">
  <AuthGate client:load>
    <div class="container mx-auto px-4 py-12">
      {question ? (
        <DoubtDetail client:load question={question} initialReplies={replies} />
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-600">Question not found.</p>
          <a href="/doubts" class="text-[#A00021] hover:underline mt-4 inline-block">
            Back to Doubts
          </a>
        </div>
      )}
    </div>
  </AuthGate>
</Layout>

