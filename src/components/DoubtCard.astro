---
interface Props {
  id: string;
  question: string;
  subject: string;
  topic: string;
  askedBy: string;
  createdAt: Date;
  status: 'open' | 'answered';
  attachments?: string[];
}

const { id, question, subject, topic, askedBy, createdAt, status, attachments = [] } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(date);
};
---

<div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-2">
        <span class="px-3 py-1 bg-[#312E81] text-white text-sm font-semibold rounded-lg">
          {subject}
        </span>
        <span class="px-3 py-1 bg-[#5EEAD4] text-[#312E81] text-sm font-semibold rounded-lg">
          {topic}
        </span>
        <span class={`px-3 py-1 text-sm font-semibold rounded-lg ${
          status === 'open' 
            ? 'bg-green-100 text-green-800' 
            : 'bg-blue-100 text-blue-800'
        }`}>
          {status === 'open' ? 'Open' : 'Answered'}
        </span>
      </div>
      <p class="text-gray-600 text-sm mb-2">
        Asked by: {askedBy === 'anonymous' ? 'Anonymous' : askedBy}
      </p>
      <p class="text-gray-500 text-xs">
        {formatDate(createdAt)}
      </p>
    </div>
  </div>
  
  <p class="text-gray-800 mb-4 leading-relaxed">
    {question}
  </p>
  
  {attachments && attachments.length > 0 && (
    <div class="mb-4">
      <p class="text-sm font-semibold text-gray-700 mb-2">Attachments:</p>
      <div class="flex flex-wrap gap-2">
        {attachments.map((url) => (
          <a 
            href={url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#312E81] hover:text-[#4F46E5] text-sm underline"
          >
            View File
          </a>
        ))}
      </div>
    </div>
  )}
  
  <a 
    href={`/doubts/${id}`}
    class="inline-block bg-[#312E81] text-white px-6 py-2 rounded-xl font-semibold hover:bg-[#312E81]/90 transition-colors"
  >
    View Details
  </a>
</div>

