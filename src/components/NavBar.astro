---
import NavBarAuth from './NavBarAuth';
---

<nav class="bg-gradient-to-r from-[#DC143C] via-[#C41E3A] to-[#DC143C] text-white shadow-lg border-b border-white/10">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center space-x-3">
        <div class="h-12 w-12 bg-white rounded-lg p-1 flex items-center justify-center shadow-sm border-2 border-white/20">
          <img 
            src="/logo-small.png" 
            alt="Shri Logo" 
            class="max-h-full max-w-full object-contain"
            loading="eager"
            width="40"
            height="40"
            onerror="console.error('Logo failed to load'); this.style.display='none';"
          />
        </div>
        <div class="flex flex-col">
          <h1 class="text-2xl font-bold">ShriSolve</h1>
          <span class="text-sm text-[#FFB347]">TSRS Moulsari</span>
        </div>
      </a>
      
      <div class="hidden md:flex items-center space-x-6">
        <a href="/" class="hover:text-[#FFB347] transition-colors">Home</a>
        <a href="/app" class="hover:text-[#FFB347] transition-colors">App</a>
        <a href="/notes" class="hover:text-[#FFB347] transition-colors">Notes</a>
        <a href="/doubts" class="hover:text-[#FFB347] transition-colors">Doubts</a>
        <a href="/ask" class="hover:text-[#FFB347] transition-colors">Ask a Doubt</a>
        <NavBarAuth client:load />
      </div>
      
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 space-y-2">
      <a href="/" class="block py-2 hover:text-[#FFB347] transition-colors">Home</a>
      <a href="/app" class="block py-2 hover:text-[#FFB347] transition-colors">App</a>
      <a href="/notes" class="block py-2 hover:text-[#FFB347] transition-colors">Notes</a>
      <a href="/doubts" class="block py-2 hover:text-[#FFB347] transition-colors">Doubts</a>
      <a href="/ask" class="block py-2 hover:text-[#FFB347] transition-colors">Ask a Doubt</a>
      <div class="py-2">
        <NavBarAuth client:load />
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

