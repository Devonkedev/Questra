---
import NavBarAuth from './NavBarAuth';
import NavBarLinks from './NavBarLinks';
import NavBarLinksMobile from './NavBarLinksMobile';
---

<nav class="bg-gradient-to-r from-[#4F46E5] via-[#4338CA] to-[#4F46E5] text-white shadow-lg border-b border-white/10">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center space-x-3">
        <img src="/favicon.svg" alt="" class="h-10 w-10 rounded-lg shadow-sm" width="40" height="40" />
        <div class="flex flex-col">
          <h1 class="text-2xl font-bold">Questra</h1>
        </div>
      </a>
      
      <div class="hidden md:flex items-center space-x-6">
        <NavBarLinks client:load />
        <NavBarAuth client:load />
      </div>
      
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 space-y-2">
      <NavBarLinksMobile client:load />
      <div class="py-2">
        <NavBarAuth client:load />
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

