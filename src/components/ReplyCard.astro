---
interface Props {
  replyText: string;
  repliedBy: string;
  timestamp: Date;
  isTeacherVerified: boolean;
  fileURL?: string;
}

const { replyText, repliedBy, timestamp, isTeacherVerified, fileURL } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(date);
};
---

<div class="bg-white rounded-xl shadow-md p-5 mb-4 border-l-4 border-[#FFD700]">
  <div class="flex items-start justify-between mb-3">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-semibold text-gray-800">{repliedBy}</span>
        {isTeacherVerified && (
          <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-lg flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Teacher Verified
          </span>
        )}
      </div>
      <p class="text-gray-500 text-xs">{formatDate(timestamp)}</p>
    </div>
  </div>
  
  <p class="text-gray-800 mb-3 leading-relaxed">{replyText}</p>
  
  {fileURL && (
    <div class="mt-3">
      <a 
        href={fileURL} 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-[#A00021] hover:text-[#FFD700] text-sm font-semibold underline"
      >
        View Attachment
      </a>
    </div>
  )}
</div>

